{
  "manifest_version": 3,
  "name": "Roblox Game Stats",
  "version": "1.0.0",
  "description": "Adds a Stats button to Roblox game pages with data from CreatorExchange, RoTerminal and RoTrends.",
  "permissions": ["scripting"],
  "host_permissions": [
    "https://creatorexchange.io/*",
    "https://roterminal.co/*",
    "https://www.rotrends.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.roblox.com/games/*", "https://www.roblox.com/*/games/*"],
      "js": ["content.js"]
    }
  ]
}
